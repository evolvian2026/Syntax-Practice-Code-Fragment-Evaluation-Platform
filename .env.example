# ---------------------------------------------------------------- server
PORT=4000
NODE_ENV=development

# Change this before deploying anywhere real.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated origins, or * for any.
CORS_ORIGIN=*

# ------------------------------------------------------------- database
# SQLite by default so the platform runs with zero external services.
# See docs/DATABASE.md for the PostgreSQL / MySQL path.
DATABASE_FILE=data/syntax-practice.db

# -------------------------------------------------------------- sandbox
# subprocess (default, hardened child process) or docker (container per run).
SANDBOX_DRIVER=subprocess
SANDBOX_TIMEOUT_MS=4000
SANDBOX_HARD_TIMEOUT_MS=15000
SANDBOX_MEMORY_MB=128
SANDBOX_MAX_CONCURRENT=4
SANDBOX_MAX_OUTPUT=65536

# Interpreters and compilers. Java/C/C++ questions are disabled gracefully
# when the toolchain is absent.
PYTHON_BIN=python3
JAVAC_BIN=javac
JAVA_BIN=java
GCC_BIN=gcc
GPP_BIN=g++

# Images used when SANDBOX_DRIVER=docker
DOCKER_IMAGE_PYTHON=python:3.11-alpine
DOCKER_IMAGE_NODE=node:20-alpine
DOCKER_IMAGE_JAVA=eclipse-temurin:21-jdk-alpine
DOCKER_IMAGE_C=gcc:13

# ------------------------------------------------------------- scoring
HINT_PENALTY_CAP=60
LEVEL_XP_STEP=250

# ------------------------------------------------------------------ AI
# Optional. Without a key the platform still works: hints, error explanations
# and recommendations fall back to deterministic behaviour.
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=1200

# ---------------------------------------------------------- seed data
SEED_ADMIN_PASSWORD=admin123
SEED_STUDENT_PASSWORD=student123
