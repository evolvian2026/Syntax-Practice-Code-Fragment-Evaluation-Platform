# Built inside the image; copying host builds in would mask a broken build.
**/node_modules
**/dist
client/.vite

# Local state and test output.
data
.tmp
test-results
playwright-report
coverage
*.log
*.db
*.db-*

# Never bake secrets into an image layer. Unlike .gitignore, these patterns are
# relative to the build context root, so server/.env needs its own **/ form.
**/.env
**/.env.*
!.env.example
!.env.production.example

.git
.github
.DS_Store
