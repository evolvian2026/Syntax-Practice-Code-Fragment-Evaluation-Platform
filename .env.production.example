# Production settings for docker compose. Copy to .env.production and fill in.
# Never commit .env.production — it holds the secrets below.

# REQUIRED. The app refuses to start without it. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# REQUIRED on first start, when the empty database is seeded. The app refuses
# to seed the demo passwords printed in the README. These become the passwords
# of the seeded admin/teacher and demo student accounts — change or remove
# those accounts once real ones exist.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# The public origin of the site, e.g. https://practice.example.com
CORS_ORIGIN=*

JWT_EXPIRES_IN=7d
SANDBOX_MAX_CONCURRENT=4

# Optional. Without a key the AI tutor falls back to deterministic hints.
AI_ENABLED=true
ANTHROPIC_API_KEY=
